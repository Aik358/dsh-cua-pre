    // ───────────────────────── apply ─────────────────────────
    // 侧栏为第三方包，footer 槽会挤占布局；改为右下角独立悬浮按钮（fixed）+ overlay 面板。
    // 注意：overlay 槽在 shell 内渲染，FAB 在独立层；点击 FAB 后需要强制触发 overlay 重渲染。
    function apply(ctx) {
      var slots = ctx.slots

      try {
        var overlayReRender = null
        // FAB 外渲染的 overlay，需要在按钮点击后显式触发宿主回调重渲染。
        // 宿主不保证 slots 回调被自动重渲染，因此加一层 DOM 层面板作为兜底（双保险）。
        var fallbackPanelRoot = null
        function ensureFallbackPanel() {
          if (fallbackPanelRoot && document.getElementById('cua-fallback-panel')) return
          var m = document.getElementById('cua-fallback-panel')
          if (!m) {
            m = document.createElement('div')
            m.id = 'cua-fallback-panel'
            m.style.cssText = 'position:fixed;right:16px;bottom:152px;z-index:9997;display:none;'
            document.body.appendChild(m)
          }
          fallbackPanelRoot = m
          syncPanelDOM()
        }
        function syncPanelDOM() {
          if (!fallbackPanelRoot) return
          try {
            if (uiOpen) {
              fallbackPanelRoot.style.display = 'block'
              fallbackPanelRoot.style.pointerEvents = 'auto'
              fallbackPanelRoot.style.opacity = '1'
            } else {
              fallbackPanelRoot.style.display = 'none'
              fallbackPanelRoot.style.opacity = '0'
              fallbackPanelRoot.style.pointerEvents = 'none'
            }
          } catch (_) {}
          try { if (overlayReRender) overlayReRender() } catch (_) {}
